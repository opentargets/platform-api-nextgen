	product: Flavor!
	"""
	API version information.
	"""
	apiVersion: Version!
	"""
	Data release version information.
	"""
	dataVersion: Version!
	"""
	Data release namespace.
	"""
	dataNamespace: String!
	"""
	Platform datasets described following MLCroissant metadata format.
	"""
	downloads: String
}

