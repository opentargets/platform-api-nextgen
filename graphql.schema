Source that provided the clinical report.
"""
enum Provider {
	"""
	ChEMBL.
	"""
	CHEMBL
	"""
	Therapeutic Target Database.
	"""
	TTD
	"""
	Aggregate Analysis of ClinicalTrials.gov.
