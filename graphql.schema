	PMDA
}

"""
Referenced publication information.
"""
type Publication {
	"""
	PubMed identifier [bioregistry:pubmed].
	"""
	pmid: String!
	"""
	PubMed Central identifier (if available) [bioregistry:pmc].
	"""
	pmcid: String
	"""
	Relevance to each queried id.
	"""
	relevances: [KeywordRelevance!]!
	"""
	Publication date.
	"""
	publicationDate: String!
}

"""
The result of a paginated query, containing the total number of items, the items, and statistics
about the query.
"""
type PublicationPage {
	count: Int!
	rows: [Publication!]!
	stats: PublicationStats!
}

"""
Statistics for a set of publications.
"""
type PublicationStats {
	"""
	Earliest publication date for the target without considering the time range.
	"""
	earliestPubDate: Int!
}

"""
The query root for the `Platform` product.
"""
type Query {
	meta: Meta!
	"""
	Full-text, multi-entity search across all types of entities (targets, diseases, drugs,
	variants or studies).
	"""
	search(
		"""
		Search query string.
		"""
		queryString: String!,
		"""
		List of entity names to search for (target, disease, drug, etc.).
		"""
		entityNames: [EntityType!],
		"""
		Pagination for the search results.
		"""
		page: Page! = {index: 0, size: 10}
	): SearchResults!
	"""
	Search sets of targets or diseases used to facet associations.
	"""
	facets(
		"""
		Search query string.
		"""
		queryString: String!,
		"""
		List of entity names to search for (target, disease).
		"""
		entityNames: [FacetEntity!],
		"""
		Category filter.
		"""
		category: String,
		"""
		Pagination for the facet search results.
		"""
		page: Page! = {index: 0, size: 10}
	): SearchFacetsResults!
	"""
	Map terms to entities (targets, diseases, drugs, variants or studies) by exact keyword
	match.
	"""
	mapIds(
		"""
		List of query terms to map.
		"""
		queryTerms: [String!]!,
		"""
		List of entity names to search for (target, disease, drug, etc.).
		"""
		entityNames: [EntityType!]
	): MappingResults!
	"""
	Retrieve a clinical report by an identifier.
	"""
	clinicalReport(
		"""
		Clinical Report ID.
		"""
		clinicalReportId: String!
	): ClinicalReport
	"""
	Retrieve a list of clinical reports by identifiers.
	"""
	clinicalReports(
		"""
		List of Clinical Report IDs.
		"""
		clinicalReportsIds: [String!]!
	): [ClinicalReport!]!
	"""
	Retrieve a list of credible sets by their identifier.
	"""
	credibleSets(
		"""
		List of study locus IDs to fetch.
		"""
		studyLocusIds: [String!]!,
		"""
		Pagination for the credible sets.
		"""
		page: Page! = {index: 0, size: 10}
	): CredibleSetPage!
	"""
	Retrieve a credible set by its identifier.
	"""
	credibleSet(
		"""
		Study locus ID to fetch.
		"""
		studyLocusId: String!
	): CredibleSet
	"""
	Fetch diseases by EFO ID.
	"""
	diseases(
		"""
		List of EFO IDs of diseases to fetch.
		"""
		efoIds: [String!]!,
		"""
		Search term to filter by.
		"""
		search: String,
		"""
		List of sort statements.
		"""
		sort: [DiseaseSort!]!,
		"""
		Pagination for the diseases.
		"""
		page: Page! = {index: 0, size: 10}
	): DiseasePage!
	disease(
		"""
		EFO ID of the disease to fetch.
		"""
		efoId: String!
	): Disease
	"""
	List of available evidence datasources and their datatypes.
	"""
	associationDatasources: [EvidenceSource!]!
	"""
	List of molecular interaction resources and their versions.
	"""
	interactionResources: [InteractionResource!]!
	studies(
		"""
		List of Study IDs to fetch. If both `studyIds` and `diseaseIds` are provided,
		                    the intersection of the two is returned.
		"""
		studyIds: [String!],
		"""
		List of Disease IDs to fetch. If both `studyIds` and `diseaseIds` are provided,
		                    the intersection of the two is returned.
		"""
		diseaseIds: [String!],
		"""
		Whether to add studies for ontology-descendant diseases in the result.
		"""
		enableIndirect: Boolean! = false,
		"""
		Search term to filter by.
		"""
		search: String,
		"""
		Filter criteria to apply.
		"""
		filter: StudyFilter,
		"""
		List of sort statements. Defaults to sample size, largest first.
		"""
		sort: [StudySort!]! = [{key: N_SAMPLES, direction: DESCENDING}],
		"""
		Pagination for the Studies.
		"""
		page: Page! = {index: 0, size: 10}
	): StudyPage!
	study(
		"""
		The Study ID to fetch.
		"""
		studyId: String!
	): Study
	"""
	Retrieve multiple drugs or clinical candidates by identifiers.
	"""
	drugs(
		"""
		List of Chembl IDs of the drugs to fetch.
		"""
		chemblIds: [String!]!,
		"""
		Pagination for the drugs.
		"""
		page: Page! = {index: 0, size: 10}
	): DrugPage!
	"""
	Retrieve a drug or a clinical candidate by an identifier.
	"""
	drug(
		"""
		Chembl ID of the drug to fetch.
		"""
		chemblId: String!
	): Drug
	"""
	Retrieve a list of variants by their identifier in the format of CHROM_POS_REF_ALT for SNPs
	and short indels (e.g. 19_44908684_T_C).
	"""
	variants(
		"""
		List of variant IDs to fetch.
		"""
		variantIds: [String!]!,
		"""
		Pagination for the variants.
		"""
		page: Page! = {index: 0, size: 10}
	): VariantPage!
	"""
	Retrieve a variant by identifier in the format of CHROM_POS_REF_ALT for SNPs and short
	indels (e.g. 19_44908684_T_C).
	"""
	variant(
		"""
		Variant ID to fetch.
		"""
		variantId: String!
	): Variant
	"""
	Retrieve multiple targets by target identifiers.
	"""
	targets(
		"""
		List of Ensembl IDs of targets to fetch.
		"""
		ensemblIds: [String!]!,
		"""
		Pagination for the targets.
		"""
		page: Page! = {index: 0, size: 10}
	): TargetPage!
	"""
	Retrieve a target (gene/protein) by target identifier (e.g. ENSG00000139618).
	"""
	target(
		"""
		Ensembl ID of the target to fetch.
		"""
		ensemblId: String!
	): Target
	"""
	GWAS credible sets for a study.
	"""
	studyCredibleSets(
		"""
		GWAS study ID to fetch credible sets for.
		"""
		studyId: String!,
		"""
		List of sort statements. Each field can be used at most once.
		"""
		sort: [StudyCredibleSetsSort!]! = [{key: P_VALUE, direction: ASCENDING}],
		"""
		Case-insensitive text search across the credible sets' text fields. Searches all fields unless `fields` is given.
		"""
		search: StudyCredibleSetsSearch,
		"""
		Pagination for the credible sets.
		"""
		page: Page! = {index: 0, size: 10}
	): StudyCredibleSetPage!
	"""
	molQTL credible sets linked to a target.
	"""
	targetCredibleSets(
		"""
		Ensembl gene ID of the target to fetch credible sets for.
		"""
		ensemblId: String!,
		"""
		Study types to include, e.g. `[eqtl, sqtl]`. Includes all when empty.
		"""
		studyTypes: [StudyType!]! = [],
		"""
		List of sort statements. Each field can be used at most once.
		"""
		sort: [TargetCredibleSetsSort!]! = [{key: P_VALUE, direction: ASCENDING}],
		"""
		Case-insensitive text search across the credible sets' text fields. Searches all fields unless `fields` is given.
		"""
		search: TargetCredibleSetsSearch,
		"""
		Pagination for the credible sets.
		"""
		page: Page! = {index: 0, size: 10}
	): TargetCredibleSetPage!
	variantCredibleSets(
		"""
		variant ID to fetch credible sets for.
		"""
		variantId: String!,
		"""
		Study types to include, e.g. `[gwas]` or the QTL types.
		"""
		studyTypes: [StudyType!]!,
		"""
		List of sort statements. Each field can be used at most once.
		"""
		sort: [VariantCredibleSetsSort!]! = [{key: TOP_L2G_SCORE, direction: DESCENDING}],
		"""
		Case-insensitive text search across the credible sets' text fields. Searches all fields unless `fields` is given.
		"""
		search: VariantCredibleSetsSearch,
		"""
		Pagination for the credible sets.
		"""
		page: Page! = {index: 0, size: 10}
	): VariantCredibleSetPage!
	variantTranscriptConsequences(
		"""
		Variant ID to fetch transcript consequences for.
		"""
		variantId: String!,
		"""
		List of sort statements. Each field can be used at most once.
		"""
		sort: [VariantTranscriptConsequencesSort!]! = [{key: DISTANCE_FROM_FOOTPRINT, direction: ASCENDING}],
		"""
		Case-insensitive text search across the gene symbol, consequence and impact. Searches all of them unless `fields` is given.
		"""
		search: VariantTranscriptConsequencesSearch,
		"""
		Pagination for the transcript consequences.
		"""
		page: Page! = {index: 0, size: 10}
	): VariantTranscriptConsequencePage!
}

"""
Pathway metadata from Reactome pathway database.
